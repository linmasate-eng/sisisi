package com.example.barcodehid

import android.Manifest
import android.app.Activity
import android.bluetooth.BluetoothAdapter
import android.bluetooth.BluetoothDevice
import android.bluetooth.BluetoothHidDevice
import android.bluetooth.BluetoothHidDeviceAppSdpSettings
import android.bluetooth.BluetoothProfile
import android.content.Context
import android.content.pm.PackageManager
import android.os.Build
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.view.ViewGroup
import android.widget.Button
import android.widget.CheckBox
import android.widget.EditText
import android.widget.LinearLayout
import android.widget.ScrollView
import android.widget.TextView
import android.widget.Toast
import org.json.JSONArray
import org.json.JSONObject
import java.util.concurrent.Executors

class MainActivity : Activity() {
    private val mainHandler = Handler(Looper.getMainLooper())
    private val executor = Executors.newSingleThreadExecutor()
    private var adapter: BluetoothAdapter? = null
    private var hid: BluetoothHidDevice? = null
    private var registered = false
    private var target: BluetoothDevice? = null
    
    private lateinit var status: TextView
    private lateinit var list: LinearLayout
    private lateinit var autoEnter: CheckBox
    private lateinit var nameInput: EditText
    private lateinit var codeInput: EditText // 改为多行输入支持批量粘贴
    private val prefs by lazy { getSharedPreferences("saved_codes_auto", Context.MODE_PRIVATE) }

    private val reportDescriptor = byteArrayOf(
        0x05.toByte(), 0x01.toByte(), 0x09.toByte(), 0x06.toByte(), 0xA1.toByte(), 0x01.toByte(), 0x85.toByte(), 0x01.toByte(),
        0x05.toByte(), 0x07.toByte(), 0x19.toByte(), 0xE0.toByte(), 0x29.toByte(), 0xE7.toByte(), 0x15.toByte(), 0x00.toByte(), 0x25.toByte(), 0x01.toByte(),
        0x75.toByte(), 0x01.toByte(), 0x95.toByte(), 0x08.toByte(), 0x81.toByte(), 0x02.toByte(),
        0x95.toByte(), 0x01.toByte(), 0x75.toByte(), 0x08.toByte(), 0x81.toByte(), 0x01.toByte(),
        0x95.toByte(), 0x05.toByte(), 0x75.toByte(), 0x01.toByte(), 0x05.toByte(), 0x08.toByte(), 0x19.toByte(), 0x01.toByte(), 0x29.toByte(), 0x05.toByte(), 0x91.toByte(), 0x02.toByte(),
        0x95.toByte(), 0x01.toByte(), 0x75.toByte(), 0x03.toByte(), 0x91.toByte(), 0x01.toByte(),
        0x95.toByte(), 0x06.toByte(), 0x75.toByte(), 0x08.toByte(), 0x15.toByte(), 0x00.toByte(), 0x25.toByte(), 0x65.toByte(), 0x05.toByte(), 0x07.toByte(),
        0x19.toByte(), 0x00.toByte(), 0x29.toByte(), 0x65.toByte(), 0x81.toByte(), 0x00.toByte(), 0xC0.toByte()
    )

    private val callback = object : BluetoothHidDevice.Callback() {
        override fun onAppStatusChanged(device: BluetoothDevice?, plugged: Boolean) {
            registered = plugged
            mainHandler.post { status.text = if (plugged) "HID 已注册；请在收银机蓝牙列表中连接手机" else "HID 未注册" }
        }
        override fun onConnectionStateChanged(device: BluetoothDevice?, state: Int) {
            if (state == BluetoothProfile.STATE_CONNECTED) {
                target = device
                mainHandler.post { status.text = "已连接键盘主机：" + safeName(device) }
            } else if (device == target && state == BluetoothProfile.STATE_DISCONNECTED) {
                mainHandler.post { status.text = "蓝牙键盘已断开" }
                target = null
            }
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        requestBluetoothPermissions()
        buildUi()
        val btAdapter = BluetoothAdapter.getDefaultAdapter()
        adapter = btAdapter
        if (btAdapter == null) status.text = "设备没有蓝牙适配器"
        else status.text = "请授予蓝牙权限，然后初始化蓝牙键盘"
    }

    private fun buildUi() {
        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(24, 24, 24, 24)
        }
        val title = TextView(this).apply { text = "批量条码快捷键盘"; textSize = 22f }
        status = TextView(this).apply { textSize = 13f; setPadding(0, 8, 0, 8) }
        
        val init = Button(this).apply {
            text = "初始化蓝牙键盘"
            setOnClickListener { initHid() }
        }
        val connect = Button(this).apply {
            text = "选择已配对的收银机"
            setOnClickListener { choosePairedHost() }
        }
        autoEnter = CheckBox(this).apply { text = "发送条码后自动回车"; isChecked = false }
        
        nameInput = EditText(this).apply { hint = "统一备注 (选填，如：VIP批次)" }
        
        // 改造为多行输入框，支持批量粘贴多行数字
        codeInput = EditText(this).apply {
            hint = "输入数字，多行或多个请换行&#10;例如：\n88001\n88002"
            minLines = 3
            maxLines = 5
            gravity = Gravity.TOP
        }
        
        val add = Button(this).apply {
            text = "批量生成并保存"
            setOnClickListener { addBatchCodes() }
        }
        
        val clearAll = Button(this).apply {
            text = "一键清空所有记录"
            setOnClickListener { clearAllCodes() }
        }

        list = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
        val scroll = ScrollView(this).apply { addView(list) }
        
        root.addView(title)
        root.addView(status)
        root.addView(init)
        root.addView(connect)
        root.addView(autoEnter)
        root.addView(nameInput)
        root.addView(codeInput)
        root.addView(add)
        root.addView(clearAll)
        root.addView(TextView(this).apply { text = "已保存的数字列表（点击发送并自动计数）"; textSize = 16f; setPadding(0, 16, 0, 8) })
        
        val scrollParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0).apply {
            weight = 1f
        }
        root.addView(scroll, scrollParams)
        setContentView(root)
        renderCodes()
    }

    private fun requestBluetoothPermissions() {
        if (Build.VERSION.SDK_INT >= 31) {
            val needed = arrayOf(Manifest.permission.BLUETOOTH_CONNECT, Manifest.permission.BLUETOOTH_ADVERTISE)
                .filter { checkSelfPermission(it) != PackageManager.PERMISSION_GRANTED }
            if (needed.isNotEmpty()) requestPermissions(needed.toTypedArray(), 20)
        }
    }

    private fun initHid() {
        if (Build.VERSION.SDK_INT < 28) {
            status.text = "系统版本过低：需要 Android 9/API 28 或更高"
            return
        }
        if (checkSelfPermission(Manifest.permission.BLUETOOTH_CONNECT) != PackageManager.PERMISSION_GRANTED && Build.VERSION.SDK_INT >= 31) {
            requestBluetoothPermissions()
            status.text = "请先授予附近设备权限，再点初始化"
            return
        }
        val bt = adapter
        if (bt == null || !bt.isEnabled) {
            status.text = "请先在手机系统中打开蓝牙"
            return
        }
        status.text = "正在请求系统蓝牙 HID 服务…"
        bt.getProfileProxy(this, object : BluetoothProfile.ServiceListener {
            override fun onServiceConnected(profile: Int, proxy: BluetoothProfile) {
                if (profile != BluetoothProfile.HID_DEVICE) return
                hid = proxy as BluetoothHidDevice
                val sdp = BluetoothHidDeviceAppSdpSettings(
                    "Barcode Keyboard", "Preset barcode sender", "OpenAI prototype",
                    BluetoothHidDevice.SUBCLASS1_KEYBOARD, reportDescriptor
                )
                val ok = hid?.registerApp(sdp, null, null, executor, callback) ?: false
                status.text = if (ok) "已提交 HID 注册请求，等待系统回调…" else "HID 注册请求失败：设备/系统可能不支持"
            }
            override fun onServiceDisconnected(profile: Int) {
                hid = null
                registered = false
                status.text = "HID 系统服务断开"
            }
        }, BluetoothProfile.HID_DEVICE)
    }

    private fun choosePairedHost() {
        val bt = adapter ?: return
        if (Build.VERSION.SDK_INT >= 31 && checkSelfPermission(Manifest.permission.BLUETOOTH_CONNECT) != PackageManager.PERMISSION_GRANTED) {
            requestBluetoothPermissions(); return
        }
        val devices = try { bt.bondedDevices.toList() } catch (_: SecurityException) { emptyList() }
        if (devices.isEmpty()) {
            status.text = "没有已配对设备：请先在收银机蓝牙设置中配对手机"
            return
        }
        val labels = devices.map { "${safeName(it)}\n${it.address}" }.toTypedArray()
        android.app.AlertDialog.Builder(this)
            .setTitle("选择收银机/键盘主机")
            .setItems(labels) { _, which ->
                val d = devices[which]
                target = d
                val ok = try { hid?.connect(d) ?: false } catch (_: Exception) { false }
                status.text = if (ok) "已请求连接：${safeName(d)}，请查看收银机状态" else "连接请求未成功；请尝试从收银机蓝牙菜单连接手机"
            }.setNegativeButton("取消", null).show()
    }

    private fun addBatchCodes() {
        val rawText = codeInput.text.toString().trim()
        val note = nameInput.text.toString().trim().ifBlank { "默认批次" }

        if (rawText.isEmpty()) {
            Toast.makeText(this, "请输入至少一串数字", Toast.LENGTH_SHORT).show()
            return
        }

        // 按行分割，支持同时粘贴多行数字
        val lines = rawText.split("\n").map { it.trim() }.filter { it.isNotEmpty() }
        if (lines.isEmpty()) {
            Toast.makeText(this, "有效数字为空", Toast.LENGTH_SHORT).show()
            return
        }

        val history = loadCodes()
        // 计算当前最大的流水号
        var maxSerial = 0
        for (i in 0 until history.length()) {
            val obj = history.optJSONObject(i)
            val s = obj?.optInt("serial", 0) ?: 0
            if (s > maxSerial) maxSerial = s
        }

        val newArray = JSONArray()
        // 新输入的放在最前面
        lines.forEach { num ->
            maxSerial++
            val itemObj = JSONObject().apply {
                put("id", System.currentTimeMillis() + maxSerial)
                put("serial", maxSerial)
                put("content", num)
                put("note", note)
                put("clickCount", 0)
            }
            newArray.put(itemObj)
        }

        // 把旧数据追加到新数据后面
        for (i in 0 until history.length()) {
            newArray.put(history.get(i))
        }

        saveCodes(newArray)
        codeInput.setText("")
        nameInput.setText("")
        renderCodes()
        Toast.makeText(this, "成功批量添加 ${lines.size} 个条码", Toast.LENGTH_SHORT).show()
    }

    private fun loadCodes(): JSONArray = try { JSONArray(prefs.getString("codes", "[]")) } catch (_: Exception) { JSONArray() }
    private fun saveCodes(arr: JSONArray) { prefs.edit().putString("codes", arr.toString()).apply() }

    private fun clearAllCodes() {
        val history = loadCodes()
        if (history.length() == 0) {
            Toast.makeText(this, "当前没有记录", Toast.LENGTH_SHORT).show()
            return
        }
        android.app.AlertDialog.Builder(this)
            .setTitle("确认清空")
            .setMessage("确定要清空所有的数字记录吗？")
            .setPositiveButton("确定") { _, _ ->
                prefs.edit().remove("codes").apply()
                renderCodes()
            }
            .setNegativeButton("取消", null)
            .show()
    }

    private fun renderCodes() {
        if (!::list.isInitialized) return
        list.removeAllViews()
        val arr = loadCodes()
        
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            val id = obj.optLong("id", 0)
            val serial = obj.optInt("serial", 0)
            val content = obj.optString("content", "")
            val note = obj.optString("note", "")
            val clickCount = obj.optInt("clickCount", 0)

            val row = LinearLayout(this).apply { 
                orientation = LinearLayout.VERTICAL
                setPadding(0, 8, 0, 8)
            }

            // 发送按钮：点击后发送蓝牙，并且计数 +1，达到 5 次自动删除
            val sendBtn = Button(this).apply {
                text = "NO.$serial [$note]\n$content\n(已用: $clickCount / 5)"
                textSize = 15f
                setOnClickListener {
                    if (!registered || hid == null) {
                        Toast.makeText(this@MainActivity, "请先初始化并注册蓝牙 HID 键盘", Toast.LENGTH_LONG).show()
                    } else if (target == null) {
                        Toast.makeText(this@MainActivity, "请先连接收银机/主机", Toast.LENGTH_LONG).show()
                    } else {
                        // 发送蓝牙数据
                        sendText(content + if (autoEnter.isChecked) "\n" else "")
                        
                        // 更新点击次数逻辑 (达到 5 次自动删除)
                        updateOrRemoveItem(id)
                    }
                }
            }

            val deleteBtn = Button(this).apply {
                text = "直接删除"
                textSize = 12f
                setOnClickListener {
                    removeItem(id)
                }
            }

            row.addView(sendBtn)
            row.addView(deleteBtn)
            list.addView(row)
        }
    }

    private fun updateOrRemoveItem(targetId: Long) {
        val arr = loadCodes()
        val newArr = JSONArray()
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            if (obj.optLong("id", 0) == targetId) {
                val count = obj.optInt("clickCount", 0) + 1
                if (count < 5) {
                    obj.put("clickCount", count)
                    newArr.put(obj)
                }
                // 如果 count >= 5 则直接过滤掉（实现满5次自动消减删除）
            } else {
                newArr.put(obj)
            }
        }
        saveCodes(newArr)
        renderCodes()
    }

    private fun removeItem(targetId: Long) {
        val arr = loadCodes()
        val newArr = JSONArray()
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            if (obj.optLong("id", 0) != targetId) {
                newArr.put(obj)
            }
        }
        saveCodes(newArr)
        renderCodes()
    }

    private fun sendText(text: String) {
        val device = target ?: return
        val h = hid ?: return
        executor.execute {
            for (ch in text) {
                val key = keyCode(ch) ?: continue
                val down = byteArrayOf(0, 0, key.toByte(), 0, 0, 0, 0, 0)
                val up = byteArrayOf(0, 0, 0, 0, 0, 0, 0, 0)
                try {
                    h.sendReport(device, 1, down)
                    Thread.sleep(5) // 加快传输速度
                    h.sendReport(device, 1, up)
                    Thread.sleep(5)
                } catch (_: Exception) {
                    mainHandler.post { status.text = "发送中断；请确认 HID 连接状态" }
                    return@execute
                }
            }
            mainHandler.post { status.text = "发送完成：${text.length} 个字符" }
        }
    }

    private fun keyCode(ch: Char): Int? = when (ch) {
        '1' -> 0x1E; '2' -> 0x1F; '3' -> 0x20; '4' -> 0x21; '5' -> 0x22
        '6' -> 0x23; '7' -> 0x24; '8' -> 0x25; '9' -> 0x26; '0' -> 0x27
        '\n', '\r' -> 0x28
        else -> null
    }

    private fun safeName(device: BluetoothDevice?): String = try {
        device?.name ?: "蓝牙设备"
    } catch (_: SecurityException) { "蓝牙设备" }

    override fun onDestroy() {
        super.onDestroy()
        try { if (registered) hid?.unregisterApp() } catch (_: Exception) {}
        try { adapter?.closeProfileProxy(BluetoothProfile.HID_DEVICE, hid) } catch (_: Exception) {}
        executor.shutdownNow()
    }
}
