    private fun autoFillUnitPrice() {
        val sku = skuInput.text.toString().trim().padStart(6, '0')
        val mapStr = prefs.getString("sku_price_map", "{}")
        try {
            val map = JSONObject(mapStr)
            if (map.has(sku)) {
                unitInput.setText(map.getString(sku))
                Toast.makeText(this, "已自动填充历史单价", Toast.LENGTH_SHORT).show()
            }
        } catch (_: Exception) {}
    }

    private fun addBatchMembers() {
        val raw = batchInput.text.toString().trim()
        val note = batchNoteInput.text.toString().trim().ifBlank { "默认批次" }
        if (raw.isEmpty()) { Toast.makeText(this, "请输入数字", Toast.LENGTH_SHORT).show(); return }
        val lines = raw.split("\n").map { it.trim() }.filter { it.isNotEmpty() }
        val history = loadJson("batch_members")
        var maxS = 0
        for (i in 0 until history.length()) {
            val s = history.optJSONObject(i)?.optInt("serial", 0) ?: 0
            if (s > maxS) maxS = s
        }
        val newArr = JSONArray()
        lines.forEach { num ->
            maxS++
            newArr.put(JSONObject().apply {
                put("id", System.currentTimeMillis() + maxS)
                put("serial", maxS)
                put("content", num)
                put("note", note)
                put("clickCount", 0)
            })
        }
        for (i in 0 until history.length()) newArr.put(history.get(i))
        saveJson("batch_members", newArr)
        batchInput.setText("")
        batchNoteInput.setText("")
        renderBatchList()
        Toast.makeText(this, "成功添加 ${lines.size} 个会员号", Toast.LENGTH_SHORT).show()
    }

    private fun renderBatchList() {
        if (!::batchListLayout.isInitialized) return
        batchListLayout.removeAllViews()
        val arr = loadJson("batch_members")
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            val id = obj.optLong("id")
            val serial = obj.optInt("serial")
            val content = obj.optString("content")
            val note = obj.optString("note")
            val count = obj.optInt("clickCount", 0)

            val row = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(0, 6, 0, 6) }
            val btn = Button(this).apply {
                text = "NO.$serial [$note] ➔ $content  (已用: $count / 5)"
                textSize = 14f
                setTextColor(Color.WHITE)
                background = createCardBg("#0F172A", 14f)
                gravity = Gravity.START or Gravity.CENTER_VERTICAL
                setPadding(20, 16, 20, 16)
                setOnClickListener {
                    if (checkReady()) {
                        sendText(content + if (autoEnter.isChecked) "\n" else "")
                        updateCountAndRender("batch_members", id, ::renderBatchList)
                    }
                }
            }
            row.addView(btn)
            batchListLayout.addView(row)
        }
    }

    private fun clearBatchCodes() {
