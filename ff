    private val callback = object : BluetoothHidDevice.Callback() {
        override fun onAppStatusChanged(device: BluetoothDevice?, plugged: Boolean) {
            registered = plugged
            mainHandler.post { status.text = if (plugged) "✨ 蓝牙 HID 已注册，请在收银机连接" else "💧 蓝牙 HID 未注册" }
        }
        override fun onConnectionStateChanged(device: BluetoothDevice?, state: Int) {
            if (state == BluetoothProfile.STATE_CONNECTED) {
                target = device
                mainHandler.post { status.text = "⭐ 已连接收银机: " + safeName(device) }
            } else if (device == target && state == BluetoothProfile.STATE_DISCONNECTED) {
                mainHandler.post { status.text = "💤 蓝牙键盘已断开" }
                target = null
            }
        }
    }

