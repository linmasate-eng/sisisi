    private fun calculateEAN13(first12: String): String {
        var sO = 0; var sE = 0
        for (i in 0 until 12) {
            val n = first12[i].toString().toInt()
            if ((i + 1) % 2 == 0) sE += n else sO += n
        }
        return first12 + ((10 - ((sO + sE * 3) % 10)) % 10)
    }

    private fun generate7SeriesCode() {
        val skuStr = skuInput.text.toString().trim()
        val valStr = weightOrPriceInput.text.toString().trim()
        val note = barNoteInput.text.toString().trim().ifBlank { "未命名" }
        if (skuStr.isEmpty() || valStr.isEmpty()) { Toast.makeText(this, "请填写完整", Toast.LENGTH_SHORT).show(); return }
        
        val sku = skuStr.padStart(6, '0')
        var grams = 0
        var subDesc = ""

        if (!isPriceMode) {
            val w = valStr.toDoubleOrNull() ?: 0.0
            grams = Math.round(w * 1000).toInt()
            subDesc = "重量: ${w}kg"
        } else {
            val u = unitInput.text.toString().toDoubleOrNull() ?: 0.0
            val t = valStr.toDoubleOrNull() ?: 0.0
            val disc = discountInput.text.toString().toDoubleOrNull() ?: 10.0 // 默认不打折
            if (u <= 0) { Toast.makeText(this, "请填写有效单价", Toast.LENGTH_SHORT).show(); return }
            
            // 折扣计算：折后总价 = 总价 * (折扣 / 10)
            val finalTotal = t * (disc / 10.0)
            grams = Math.round((finalTotal / u) * 1000).toInt()
            
            subDesc = if (disc < 10.0) {
                "原价:${t}元 [${disc}折] ➔ 折后:${String.format("%.2f", finalTotal)}元 (约${String.format("%.3f", grams / 1000.0)}kg)"
            } else {
                "总价: ${t}元 (约${String.format("%.3f", grams / 1000.0)}kg)"
            }

            try {
                val map = JSONObject(prefs.getString("sku_price_map", "{}"))
                map.put(sku, u.toString())
                prefs.edit().putString("sku_price_map", map.toString()).apply()
            } catch (_: Exception) {}
        }

        val code = calculateEAN13("7" + sku + grams.toString().padStart(5, '0'))
        val history = loadJson("series7_codes")
        var maxS = 0
        for (i in 0 until history.length()) {
            val s = history.optJSONObject(i)?.optInt("serial", 0) ?: 0
            if (s > maxS) maxS = s
        }
        maxS++

        val newArr = JSONArray().put(JSONObject().apply {
            put("id", System.currentTimeMillis())
            put("serial", maxS)
            put("content", code)
            put("note", note)
            put("sub", subDesc)
        })
        for (i in 0 until history.length()) newArr.put(history.get(i))
        saveJson("series7_codes", newArr)
        weightOrPriceInput.setText("")
        discountInput.setText("")
        renderBarList()
        Toast.makeText(this, "7系条码生成成功！", Toast.LENGTH_SHORT).show()
    }

    private fun renderBarList() {
        if (!::barListLayout.isInitialized) return
        barListLayout.removeAllViews()
        val arr = loadJson("series7_codes")
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            val id = obj.optLong("id")
            val serial = obj.optInt("serial")
            val code = obj.optString("content")
            val note = obj.optString("note")
            val sub = obj.optString("sub")

            val row = LinearLayout(this).apply { 
                orientation = LinearLayout.HORIZONTAL
                weightSum = 5f
                setPadding(0, 4, 0, 4) 
            }
            val btn = Button(this).apply {
                text = "NO.$serial [$note] $sub\n条码: $code"
                textSize = 13f
                setTextColor(Color.parseColor("#0F172A"))
                background = createAnimeCardBg("#F8FAFC", 14f)
                gravity = Gravity.START or Gravity.CENTER_VERTICAL
                setPadding(16, 14, 16, 14)
                setOnClickListener {
                    if (checkReady()) {
                        sendText(code + if (autoEnter.isChecked) "\n" else "")
                    }
                }
                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 4f).apply { setMargins(0,0,6,0) }
            }
            
            val delBtn = Button(this).apply {
                text = "删"
                textSize = 12f
                setTextColor(Color.parseColor("#EF4444"))
                background = createAnimeCardBg("#FEE2E2", 14f)
                setOnClickListener { removeItem("series7_codes", id, ::renderBarList) }
                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
            }

            row.addView(btn)
            row.addView(delBtn)
            barListLayout.addView(row)
        }
    }

    private fun clear7SeriesCodes() {
        prefs.edit().remove("series7_codes").apply()
        renderBarList()
    }

    private fun loadJson(key: String): JSONArray = try { JSONArray(prefs.getString(key, "[]")) } catch (_: Exception) { JSONArray() }
    private fun saveJson(key: String, arr: JSONArray) { prefs.edit().putString(key, arr.toString()).apply() }

    private fun updateCountAndRender(key: String, targetId: Long, renderFunc: () -> Unit) {
        val arr = loadJson(key)
        val newArr = JSONArray()
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            if (obj.optLong("id", 0) == targetId) {
                val count = obj.optInt("clickCount", 0) + 1
                if (count < 5) {
                    obj.put("clickCount", count)
                    newArr.put(obj)
                }
            } else {
                newArr.put(obj)
            }
        }
        saveJson(key, newArr)
        renderFunc()
    }

    private fun removeItem(key: String, targetId: Long, renderFunc: () -> Unit) {
        val arr = loadJson(key)
        val newArr = JSONArray()
        for (i in 0 until arr.length()) {
            val obj = arr.optJSONObject(i) ?: continue
            if (obj.optLong("id", 0) != targetId) {
                newArr.put(obj)
            }
        }
        saveJson(key, newArr)
        renderFunc()
    }

    private fun checkReady(): Boolean {
        if (!registered || hid == null) { Toast.makeText(this, "请先初始化蓝牙", Toast.LENGTH_SHORT).show(); return false }
        if (target == null) { Toast.makeText(this, "请先选择收银机", Toast.LENGTH_SHORT).show(); return false }
        return true
    }

    private fun requestBluetoothPermissions() {
        if (Build.VERSION.SDK_INT >= 31) {
            val needed = arrayOf(Manifest.permission.BLUETOOTH_CONNECT, Manifest.permission.BLUETOOTH_ADVERTISE)
                .filter { checkSelfPermission(it) != PackageManager.PERMISSION_GRANTED }
            if (needed.isNotEmpty()) requestPermissions(needed.toTypedArray(), 20)
        }
    }

    private fun initHid() {
        if (Build.VERSION.SDK_INT < 28) { status.text = "系统版本过低"; return }
        val bt = adapter ?: return
        if (!bt.isEnabled) { status.text = "请先打开手机蓝牙"; return }
        bt.getProfileProxy(this, object : BluetoothProfile.ServiceListener {
            override fun onServiceConnected(profile: Int, proxy: BluetoothProfile) {
                if (profile != BluetoothProfile.HID_DEVICE) return
                hid = proxy as BluetoothHidDevice
                val sdp = BluetoothHidDeviceAppSdpSettings("Keyboard", "Desc", "Prov", BluetoothHidDevice.SUBCLASS1_KEYBOARD, reportDescriptor)
                val ok = hid?.registerApp(sdp, null, null, executor, callback) ?: false
                mainHandler.post { status.text = if (ok) "✨ HID 注册请求已提交" else "💧 注册失败" }
            }
            override fun onServiceDisconnected(profile: Int) { hid = null; registered = false }
        }, BluetoothProfile.HID_DEVICE)
    }

    private fun choosePairedHost() {
        val bt = adapter ?: return
        val devices = try { bt.bondedDevices.toList() } catch (_: SecurityException) { emptyList() }
        if (devices.isEmpty()) { status.text = "没有已配对设备"; return }
        val labels = devices.map { "${safeName(it)}\n${it.address}" }.toTypedArray()
        android.app.AlertDialog.Builder(this)
            .setTitle("选择收银机")
            .setItems(labels) { _, which ->
                target = devices[which]
                status.text = "⭐ 已连接: ${safeName(target)}"
            }.setNegativeButton("取消", null).show()
    }

    private fun sendText(text: String) {
        val device = target ?: return
        val h = hid ?: return
        executor.execute {
            for (ch in text) {
                val key = keyCode(ch) ?: continue
                try {
                    h.sendReport(device, 1, byteArrayOf(0, 0, key.toByte(), 0, 0, 0, 0, 0))
                    Thread.sleep(5)
                    h.sendReport(device, 1, byteArrayOf(0, 0, 0, 0, 0, 0, 0, 0))
                    Thread.sleep(5)
                } catch (_: Exception) { break }
            }
        }
    }

    private fun keyCode(ch: Char): Int? = when (ch) {
        '1' -> 0x1E; '2' -> 0x1F; '3' -> 0x20; '4' -> 0x21; '5' -> 0x22
        '6' -> 0x23; '7' -> 0x24; '8' -> 0x25; '9' -> 0x26; '0' -> 0x27
        '\n', '\r' -> 0x28
        else -> null
    }

    private fun safeName(device: BluetoothDevice?): String = try { device?.name ?: "蓝牙设备" } catch (_: SecurityException) { "蓝牙设备" }

    override fun onDestroy() {
        super.onDestroy()
        try { if (registered) hid?.unregisterApp() } catch (_: Exception) {}
        try { adapter?.closeProfileProxy(BluetoothProfile.HID_DEVICE, hid) } catch (_: Exception) {}
        executor.shutdownNow()
    }
}
