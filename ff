    private val callback = object : BluetoothHidDevice.Callback() {
        override fun onAppStatusChanged(device: BluetoothDevice?, plugged: Boolean) {
            registered = plugged
            mainHandler.post { status.text = if (plugged) "HID 已注册；请在收银机连接" else "HID 未注册" }
        }
        override fun onConnectionStateChanged(device: BluetoothDevice?, state: Int) {
            if (state == BluetoothProfile.STATE_CONNECTED) {
                target = device
                mainHandler.post { status.text = "已连接主机：" + safeName(device) }
            } else if (device == target && state == BluetoothProfile.STATE_DISCONNECTED) {
                mainHandler.post { status.text = "蓝牙键盘已断开" }
                target = null
            }
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        requestBluetoothPermissions()
        buildUi()
        val btAdapter = BluetoothAdapter.getDefaultAdapter()
        adapter = btAdapter
        if (btAdapter == null) status.text = "设备没有蓝牙适配器"
        else status.text = "请授予蓝牙权限并初始化蓝牙"
    }

